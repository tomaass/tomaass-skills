{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/require-worktree.sh",
            "args": [],
            "statusMessage": "Checking worktree isolation…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-main-commit.sh",
            "args": [],
            "statusMessage": "Checking commit target…"
          }
        ]
      }
    ]
  }
}
